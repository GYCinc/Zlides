#!/usr/bin/env python3
"""Zlides CLI — send content to the printing press from the terminal.

Usage:
    zlides "Create slides about photosynthesis"
    zlides --format report --style gitenglish < notes.md
    cat lesson.md | zlides -f slides -s dark -o lesson.html --open

Flags:
    -f, --format    slides|poster|worksheet|report|rr  (default: report)
    -s, --style     auto|gitenglish|clean|dark|minimal  (default: auto)
    -o, --output    Save to file instead of stdout
    --open          Open result in browser after generation
    -h, --help      Show this help
"""

import sys
import json
import argparse
import urllib.request
import urllib.error
import webbrowser
from pathlib import Path

BASE_URL = "http://localhost:2828"


def main():
    parser = argparse.ArgumentParser(
        prog="zlides",
        description="Send content to the Zlides printing press.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "content",
        nargs="?",
        default=None,
        help="Content to design. If omitted, reads from stdin or --file.",
    )
    parser.add_argument(
        "-F", "--file",
        default=None,
        help="Read content from a file (json, md, txt, html, csv, etc.)",
    )
    parser.add_argument(
        "-f", "--format",
        default="report",
        choices=["slides", "poster", "worksheet", "report", "rr"],
        help="Output format (default: report)",
    )
    parser.add_argument(
        "-s", "--style",
        default="auto",
        help="Style pack (default: auto)",
    )
    parser.add_argument(
        "-p", "--pages",
        type=int,
        default=None,
        help="Number of pages/slides (default: let agent decide)",
    )
    parser.add_argument(
        "-o", "--output",
        default=None,
        help="Save to file instead of stdout",
    )
    parser.add_argument(
        "--open",
        action="store_true",
        help="Open result in browser after generation",
    )

    args = parser.parse_args()

    # Get content from arg, file, or stdin
    if args.content:
        content = args.content
    elif args.file:
        try:
            content = Path(args.file).read_text(encoding="utf-8")
        except Exception as e:
            print(f"Error reading {args.file}: {e}", file=sys.stderr)
            sys.exit(1)
    elif not sys.stdin.isatty():
        content = sys.stdin.read()
    else:
        print("Error: provide content as argument or pipe via stdin", file=sys.stderr)
        sys.exit(1)

    if not content.strip():
        print("Error: empty content", file=sys.stderr)
        sys.exit(1)

    # Send to printing press
    payload = json.dumps({
        "message": content,
        "format": args.format,
        "style": args.style,
        "page_count": args.pages,
    }).encode("utf-8")

    print("Sending to printing press...", file=sys.stderr)

    try:
        req = urllib.request.Request(
            f"{BASE_URL}/api/print",
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=600) as resp:
            result = json.loads(resp.read().decode("utf-8"))
    except urllib.error.URLError:
        print(f"Error: cannot connect to Zlides at {BASE_URL}. Is the server running?", file=sys.stderr)
        print("Start it with: ./launch.sh", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    html = result.get("html", "")
    if not html:
        print("Error: no HTML returned", file=sys.stderr)
        sys.exit(1)

    # Output
    if args.output:
        Path(args.output).write_text(html, encoding="utf-8")
        print(f"Saved to {args.output}", file=sys.stderr)
        if args.open:
            webbrowser.open(f"file://{Path(args.output).resolve()}")
    elif args.open:
        outfile = Path("/tmp/zlides_output.html")
        outfile.write_text(html, encoding="utf-8")
        webbrowser.open(f"file://{outfile.resolve()}")
    else:
        print(html)


if __name__ == "__main__":
    main()
